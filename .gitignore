# Local, machine-specific files that must never be committed.
# (Generated development mail is ignored by storage/mail/.gitignore.)

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Local environment / secret files (the application reads its settings from Apache SetEnv)
.env
.env.*

# Logs
*.log

# Runtime user uploads: keep the directories (via .gitkeep) but never the uploaded files.
# uploads/.htaccess stays tracked; generated mail is already ignored by storage/mail/.gitignore.
uploads/profiles/*
!uploads/profiles/.gitkeep
uploads/posts/*
!uploads/posts/.gitkeep
uploads/certificates/*
!uploads/certificates/.gitkeep
